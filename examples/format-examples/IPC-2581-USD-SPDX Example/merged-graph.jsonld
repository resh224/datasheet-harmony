                                "U1.16"
                            ]
                        }
                    }
                ],
                "FabricationDrawings": {
                    "DrillDrawing": "drill.drl",
                    "SolderMaskDrawing": "mask_top.gbr"
                },
                "AssemblyInstructions": {
                    "PickAndPlace": "pickplace.csv",
                    "Soldering": {
                        "type": "Reflow"
                    },
                    "SpecialInstructions": "Use lead-free solder paste. Place U1 with orientation dot facing Pin 1 marker."
                }
            }
        },
