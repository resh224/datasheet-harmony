            "@id": "urn:acme:pcb:acme1234",
            "Design": {
                "Stackup": [
                    {
                        "Layer": {
                            "name": "Top",
                            "type": "Signal",
                            "thickness": 0.035
                        }
                    },
                    {
                        "Layer": {
                            "name": "Core",
                            "type": "Dielectric",
                            "thickness": 0.18
                        }
                    },
                    {
                        "Layer": {
                            "name": "Bottom",
                            "type": "Signal",
                            "thickness": 0.035
                        }
                    }
                ],
                "Components": [
                    {
                        "Component": {
                            "ref": "U1",
                            "name": "ACME1234",
                            "value": "PMIC",
                            "footprint": "QFN32",
                            "Datasheet": "https://acme.com/datasheets/ACME1234.pdf",
                            "BOMReference": "BOM001"
                        }
                    }
                ],
                "Netlist": [
